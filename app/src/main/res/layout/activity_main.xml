<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neo_bg">

    <!-- 相机预览 - 全屏 -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 构图叠加层 -->
    <com.aicomp.OverlayView
        android:id="@+id/overlayView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@id/previewView"
        app:layout_constraintBottom_toBottomOf="@id/previewView"
        app:layout_constraintStart_toStartOf="@id/previewView"
        app:layout_constraintEnd_toEndOf="@id/previewView" />

    <!-- ───────────────────────────────────────────
         顶部状态栏：极简 — 透明背景 + 细文字
         ─────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_gradient_top"
        android:paddingHorizontal="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="8dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 场景检测标签：近灰白色，非高亮 -->
        <TextView
            android:id="@+id/sceneHintText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/neo_text_secondary"
            android:textSize="12sp"
            android:letterSpacing="0.04"
            android:text="—"
            android:maxLines="1" />

        <!-- 网格开关 -->
        <ImageButton
            android:id="@+id/gridToggle"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_grid"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="网格"
            android:layout_marginEnd="4dp" />

        <!-- 闪光灯开关 -->
        <ImageButton
            android:id="@+id/flashToggle"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_flash_off"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="闪光灯"
            android:layout_marginEnd="4dp" />

        <!-- 设置齿轮 -->
        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_menu_preferences"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="设置"
            android:tint="@color/neo_icon" />

    </LinearLayout>

    <!-- ───────────────────────────────────────────
         AI 指导面板：玻璃卡片 — 克制、小字、不抢画面
         ─────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/aiPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_hint_bubble"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:maxWidth="300dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="6dp"
        android:layout_marginHorizontal="16dp">

        <!-- 场景标签 + 评分行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="5dp">

            <TextView
                android:id="@+id/aiSceneLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/neo_accent"
                android:textSize="11sp"
                android:letterSpacing="0.06"
                android:textAllCaps="true" />

            <TextView
                android:id="@+id/aiScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/neo_text_hint"
                android:textSize="11sp" />

            <ProgressBar
                android:id="@+id/aiLoadingIndicator"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:visibility="gone"
                style="?android:attr/progressBarStyleSmall"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <!-- 构图建议 -->
        <TextView
            android:id="@+id/aiCompositionAdvice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/neo_text_secondary"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp" />

        <!-- 技术建议 -->
        <TextView
            android:id="@+id/aiTechnicalAdvice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/neo_text_hint"
            android:textSize="11sp"
            android:layout_marginTop="3dp" />

        <!-- 拍摄小贴士 -->
        <TextView
            android:id="@+id/aiShootingTip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/neo_success"
            android:textSize="11sp"
            android:layout_marginTop="3dp" />

        <!-- 关键调整项 -->
        <LinearLayout
            android:id="@+id/aiAdjustmentsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="5dp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- ───────────────────────────────────────────
         构图引导提示：规则引擎 Fallback
         ─────────────────────────────────────────── -->
    <TextView
        android:id="@+id/guidanceText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_hint_bubble"
        android:textColor="@color/neo_text_secondary"
        android:textSize="13sp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:gravity="center"
        android:maxWidth="260dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/aiPanel"
        app:layout_constraintBottom_toTopOf="@id/arrowIndicator"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.35" />

    <!-- 中心箭头指示器 -->
    <ImageView
        android:id="@+id/arrowIndicator"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/ic_arrow"
        android:background="@drawable/bg_circle_transparent"
        android:padding="14dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- ───────────────────────────────────────────
         底部控制栏：透明底 + 极简按钮
         ─────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_gradient_bottom"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 灵敏度控制行：极简分割线 -->
        <LinearLayout
            android:id="@+id/sensitivityRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="灵敏度"
                android:textColor="@color/neo_text_hint"
                android:textSize="11sp"
                android:paddingEnd="8dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="0.5dp"
                android:layout_weight="1"
                android:background="@color/neo_divider" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- 前后摄像头切换 -->
            <ImageButton
                android:id="@+id/cameraSwitch"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_switch_camera"
                android:background="?attr:selectableItemBackgroundBorderless"
                android:contentDescription="切换摄像头"
                android:layout_marginEnd="20dp" />

            <!-- AI 辅助按钮 -->
            <FrameLayout
                android:id="@+id/aiAssistButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_ai_assist">

                <TextView
                    android:id="@+id/aiAssistLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="AI"
                    android:textColor="@color/neo_text_hint"
                    android:textSize="11sp"
                    android:letterSpacing="0.08" />

                <ProgressBar
                    android:id="@+id/aiAssistProgress"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    android:indeterminateTint="@color/neo_accent" />

            </FrameLayout>

            <!-- 拍照按钮 -->
            <FrameLayout
                android:id="@+id/captureButton"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_capture_button">

                <View
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_capture_inner" />

            </FrameLayout>

            <!-- 自动快门开关 -->
            <View
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="20dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/autoShutterToggle"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="自动"
                android:textSize="12sp"
                android:textColor="@color/neo_text_hint"
                android:minWidth="0dp"
                android:paddingHorizontal="4dp"
                app:icon="@drawable/ic_auto"
                app:iconTint="@color/neo_text_hint"
                app:iconSize="18dp"
                app:iconPadding="4dp" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
