<?xml version="1.0" encoding="utf-8"?>
<!--
    性冷淡风格：AI 辅助按钮
    极细描边 + 微透明填充，悬停时边缘光晕
    克制：不喧宾夺主于画面
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 按下态：边缘青光晕 -->
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#1A3030" />
            <stroke android:width="1dp" android:color="#5AC8C8" />
        </shape>
    </item>
    <!-- 启用态（默认）：极细描边 -->
    <item android:state_enabled="true">
        <shape android:shape="oval">
            <solid android:color="#0D0D0D" />
            <stroke android:width="0.75dp" android:color="#3A3A3A" />
        </shape>
    </item>
    <!-- 禁用态：极暗 -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#0D0D0D" />
            <stroke android:width="0.5dp" android:color="#1F1F1F" />
        </shape>
    </item>
</selector>
